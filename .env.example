# ============================================
# HANDLE GROWTH AGENT V2 — Variables de entorno
# Copia este archivo como .env y rellena los valores
# ============================================

# --- APP ---
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# --- ANTHROPIC ---
ANTHROPIC_API_KEY=sk-ant-...

# --- DATABASE (Supabase o PostgreSQL propio) ---
DATABASE_URL=postgresql://user:password@localhost:5432/handle_growth

# --- APOLLO.IO (Lead sourcing) ---
APOLLO_API_KEY=...

# --- MAILGUN (Email tracking) ---
MAILGUN_API_KEY=...
MAILGUN_DOMAIN=mg.tudominio.com
EMAIL_FROM=growth@tudominio.com

# --- SLACK (Alertas) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#handle-growth

# --- SEGURIDAD ---
API_SECRET_KEY=cambia-esto-por-algo-seguro-generado

# --- CRON SCHEDULES (cron syntax) ---
DAILY_DIGEST_CRON=0 6 * * *
WEEKLY_PLAYBOOK_CRON=0 8 * * 1
BIWEEKLY_OUTREACH_CRON=0 8 1,15 * *
